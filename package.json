{
  "name": "commander-brawl",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "src/*"
  ],
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron build/app",
    "package": "node scripts/package.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test -c tests/browser",
    "test:e2e": "node scripts/build.mjs && playwright test -c tests/e2e",
    "check": "npm run typecheck && npm run lint && prettier --check . && npm test && npm run test:browser",
    "format": "prettier --write .",
    "icons": "node scripts/icons.mjs",
    "game-icons": "node scripts/game-icons.mjs"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
